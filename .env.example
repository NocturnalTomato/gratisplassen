# Lokaal ontwikkelen: laat leeg, dan gebruikt de app een lokaal SQLite-bestand (data/local.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Geheime sleutel om IP-adressen te hashen (nooit ruwe IP's opslaan)
IP_HASH_SECRET=verander-mij-naar-iets-random

# Link voor het "Trakteer me op koffie"-knopje.
# Makkelijkste opties zonder poespas: maak een gratis pagina op
# https://ko-fi.com (eenmalige "buy me a coffee"-betaling) of
# https://www.buymeacoffee.com, en zet die link hieronder.
# Nu staat er een placeholder — vervang 'm voor deploy.
NEXT_PUBLIC_DONATE_URL=https://ko-fi.com/gratisplassen
